async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    args = context.args

    referred_by = None
    if args and args[0].startswith("NX"):
        try:
            referred_by = int(args[0][2:])
        except:
            pass

    if not get_user(user.id):
        create_user(user.id, user.username, user.first_name, referred_by)

    user_data = get_user(user.id)
    if user_data[9]: # onboarding_done
        await update.message.reply_text("Welcome back!", reply_markup=main_menu())
        return

    text = """Welcome to Nexarion Rewards Bot.

Complete tasks, invite friends, earn points, and redeem airtime.

To continue, join our Telegram channel."""

    keyboard = [
        [InlineKeyboardButton("Join Channel", url=CHANNEL_LINK)],
        [InlineKeyboardButton("Verify Channel", callback_data="verify_channel")]
    ]
    await update.message.reply_text(text, reply_markup=InlineKeyboardMarkup(keyboard))

async def button_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    user_id = query.from_user.id
    data = query.data

    user = get_user(user_id)
    if not user or user[8]: # banned
        await query.edit_message_text("You are banned from using this bot.")
        return

    if data == "verify_channel":
        if is_task_completed(user_id, -1): # -1 for channel task
            await query.edit_message_text("Channel already verified.")
            return

        is_member = await check_channel_member(context, user_id)
        if is_member:
            if complete_task(user_id, -1):
                add_points(user_id, POINTS_CHANNEL_JOIN, "Channel Join Reward")
                await query.edit_message_text(
                    f"✅ Verified! You earned {POINTS_CHANNEL_JOIN} points.\n\nNext step:",
                    reply_markup=InlineKeyboardMarkup([
                        [InlineKeyboardButton("Follow on X", url=X_LINK)],
                        [InlineKeyboardButton("Done", callback_data="x_done")]
                    ])
                )
        else:
            await query.answer("You haven't joined the channel yet.", show_alert=True)

    elif data == "x_done":
        conn = sqlite3.connect("nexarion.db")
        c = conn.cursor()
        c.execute("SELECT opened_x_link FROM users WHERE user_id =?", (user_id,))
        opened = c.fetchone()[0]
        conn.close()

        if not opened:
            await query.answer("Please click 'Follow on X' first.", show_alert=True)
            return

        if is_task_completed(user_id, -2): # -2 for X task
            await query.edit_message_text("X follow already verified.")
            return

        if complete_task(user_id, -2):
            add_points(user_id, POINTS_X_FOLLOW, "X Follow Reward")
            conn = sqlite3.connect("nexarion.db")
            c = conn.cursor()
