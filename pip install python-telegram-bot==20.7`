async def handle_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    if context.user_data.get('awaiting_phone'):
        phone = update.message.text.strip()
        network = context.user_data.get('withdraw_network')
        balance, _, _, _, _ = get_user_stats(user_id)

        max_naira = balance * POINTS_TO_NAIRA
        max_naira = min(max_naira, DAILY_WITHDRAW_LIMIT_NAIRA)
        max_points = int(max_naira / POINTS_TO_NAIRA)

        if max_points < MIN_WITHDRAW_POINTS:
            await update.message.reply_text("Insufficient balance for withdrawal.", reply_markup=main_menu())
            context.user_data.clear()
            return

        # Check daily limit
        conn = sqlite3.connect("nexarion.db")
        c = conn.cursor()
        today = datetime.now().date().isoformat()
        c.execute("""SELECT SUM(amount_naira) FROM withdrawals
                     WHERE user_id =? AND date(created_at) =? AND status!= 'rejected'""",
                  (user_id, today))
        used_today = c.fetchone()[0] or 0
        conn.close()

        remaining_naira = DAILY_WITHDRAW_LIMIT_NAIRA - used_today
        if remaining_naira <= 0:
            await update.message.reply_text("Daily withdrawal limit reached.", reply_markup=main_menu())
            context.user_data.clear()
            return

        withdraw_points = min(max_points, int(remaining_naira / POINTS_TO_NAIRA))
        withdraw_naira = int(withdraw_points * POINTS_TO_NAIRA)

        conn = sqlite3.connect("nexarion.db")
        c = conn.cursor()
        c.execute('''INSERT INTO withdrawals (user_id, points, amount_naira, phone, network, created_at)
                     VALUES (?,?,?,?,?,?)''',
                  (user_id, withdraw_points, withdraw_naira, phone, network, datetime.now().isoformat()))
        conn.commit()
        conn.close()

        deduct_points(user_id, withdraw_points, f"Withdrawal to {network} {phone}")
        context.user_data.clear()

        await update.message.reply_text(
            f"✅ Withdrawal request submitted\n\nAmount: ₦{withdraw_naira}\nNetwork: {network}\nPhone: {phone}\nPoints Deducted: {withdraw_points}\n\nStatus: Pending admin approval",
            reply_markup=main_menu()
        )

        # Notify admins
        for admin_id in ADMIN_IDS:
            try:
                await context.bot.send_message(admin_id,
                    f"New withdrawal request:\nUser: {user_id}\n₦{withdraw_naira} to {network} {phone}")
            except:
                pass

