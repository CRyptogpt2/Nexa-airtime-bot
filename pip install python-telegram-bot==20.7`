def init_db():
    conn = sqlite3.connect("nexarion.db")
    c = conn.cursor()

    c.execute('''CREATE TABLE IF NOT EXISTS users (
        user_id INTEGER PRIMARY KEY,
        username TEXT,
        first_name TEXT,
        points INTEGER DEFAULT 0,
        referral_code TEXT UNIQUE,
        referred_by INTEGER,
        join_date TEXT,
        banned INTEGER DEFAULT 0,
        onboarding_done INTEGER DEFAULT 0,
        opened_x_link INTEGER DEFAULT 0
    )''')

    c.execute('''CREATE TABLE IF NOT EXISTS tasks (
        task_id INTEGER PRIMARY KEY AUTOINCREMENT,
        title TEXT,
        description TEXT,
        link TEXT,
        reward INTEGER,
        task_type TEXT,
        active INTEGER DEFAULT 1
    )''')

    c.execute('''CREATE TABLE IF NOT EXISTS completed_tasks (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        task_id INTEGER,
        completed_at TEXT,
        UNIQUE(user_id, task_id)
    )''')

    c.execute('''CREATE TABLE IF NOT EXISTS referrals (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        referrer_id INTEGER,
        referred_id INTEGER,
        rewarded INTEGER DEFAULT 0,
        created_at TEXT,
        UNIQUE(referrer_id, referred_id)
    )''')

    c.execute('''CREATE TABLE IF NOT EXISTS withdrawals (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        points INTEGER,
        amount_naira INTEGER,
        phone TEXT,
        network TEXT,
        status TEXT DEFAULT 'pending',
        created_at TEXT
    )''')

    c.execute('''CREATE TABLE IF NOT EXISTS transactions (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        points INTEGER,
        type TEXT,
        description TEXT,
        created_at TEXT
    )''')

    c.execute('''CREATE TABLE IF NOT EXISTS settings (
        key TEXT PRIMARY KEY,
        value TEXT
    )''')

    c.execute('''CREATE TABLE IF NOT EXISTS admins (
        user_id INTEGER PRIMARY KEY
    )''')

    for admin_id in ADMIN_IDS:
        c.execute("INSERT OR IGNORE INTO admins (user_id) VALUES (?)", (admin_id,))

    conn.commit()
    conn.close()

def get_user(user_id):
    conn = sqlite3.connect("nexarion.db")
    c = conn.cursor()
    c.execute("SELECT * FROM users WHERE user_id =?", (user_id,))
    user = c.fetchone()
    conn.close()
    return user

def create_user(user_id, username, first_name, referred_by=None):
    conn = sqlite3.connect("nexarion.db")
    c = conn.cursor()
    referral_code = f"NX{user_id}"
    join_date = datetime.now().isoformat()
    try:
        c.execute('''INSERT INTO users (user_id, username, first_name, referral_code, referred_by, join_date)
                     VALUES (?,?,?,?,?,?)''',
                  (user_id, username, first_name, referral_code, referred_by, join_date))
        conn.commit()
        if referred_by and referred_by!= user_id:
            c.execute('''INSERT OR IGNORE INTO referrals (referrer_id, referred_id, created_at)
                         VALUES (?,?,?)''', (referred_by, user_id, join_date))
            conn.commit()
    except sqlite3.IntegrityError:
        pass
    conn.close()

def add_points(user_id, points, description):
    conn = sqlite3.connect("nexarion.db")
    c = conn.cursor()
    c.execute("UPDATE users SET points = points +? WHERE user_id =?", (points, user_id))
    c.execute('''INSERT INTO transactions (user_id, points, type, description, created_at)
                 VALUES (?,?, 'credit',?,?)''',
              (user_id, points, description, datetime.now().isoformat()))
    conn.commit()
    conn.close()

def deduct_points(user_id, points, description):
    conn = sqlite3.connect("nexarion.db")
    c = conn.cursor()
    c.execute("UPDATE users SET points = points -? WHERE user_id =?", (points, user_id))
    c.execute('''INSERT INTO transactions (user_id, points, type, description, created_at)
                 VALUES (?,?, 'debit',?,?)''',
              (user_id, points, description, datetime.now().isoformat()))
    conn.commit()
    conn.close()

def is_task_completed(user_id, task_id):
    conn = sqlite3.connect("nexarion.db")
    c = conn.cursor()
    c.execute("SELECT 1 FROM completed_tasks WHERE user_id =? AND task_id =?", (user_id, task_id))
    result = c.fetchone()
    conn.close()
    return result is not None

def complete_task(user_id, task_id):
    conn = sqlite3.connect("nexarion.db")
    c = conn.cursor()
    try:
        c.execute("INSERT INTO completed_tasks (user_id, task_id, completed_at) VALUES (?,?,?)",
                  (user_id, task_id, datetime.now().isoformat()))
        conn.commit()
        return True
    except sqlite3.IntegrityError:
        return False
    finally:
        conn.close()

async def check_channel_member(context: ContextTypes.DEFAULT_TYPE, user_id: int):
    try:
        member = await context.bot.get_chat_member(CHANNEL_ID, user_id)
        return member.status in ['member', 'administrator', 'creator']
    except BadRequest:
        return False

def get_user_stats(user_id):
    conn = sqlite3.connect("nexarion.db")
    c = conn.cursor()
    c.execute("SELECT points FROM users WHERE user_id =?", (user_id,))
    balance = c.fetchone()[0]

    c.execute("SELECT COUNT(*) FROM referrals WHERE referrer_id =? AND rewarded = 1", (user_id,))
    ref_count = c.fetchone()[0]

    ref_earnings = ref_count * POINTS_REFERRAL

    c.execute("SELECT SUM(points) FROM transactions WHERE user_id =? AND type = 'credit'", (user_id,))
    total_earned = c.fetchone()[0] or 0

    c.execute("SELECT SUM(points) FROM transactions WHERE user_id =? AND type = 'debit'", (user_id,))
    total_withdrawn = c.fetchone()[0] or 0

    conn.close()
    return balance, ref_count, ref_earnings, total_earned, total_withdrawn

