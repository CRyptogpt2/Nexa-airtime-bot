async def broadcast_input(update: Update, context: ContextTypes.DEFAULT_TYPE):
    btype = context.user_data.get("broadcast_type")
    conn = get_db()
    users = conn.execute("SELECT user_id FROM users WHERE onboarding_complete=1 AND is_banned=0").fetchall()
    conn.close()

    sent = 0
    failed = 0
    for u in users:
        try:
            if btype == "text":
                await context.bot.send_message(u["user_id"], update.message.text)
            elif btype == "photo" and update.message.photo:
                await context.bot.send_photo(u["user_id"], update.message.photo[-1].file_id, caption=update.message.caption or "")
            elif btype == "video" and update.message.video:
                await context.bot.send_video(u["user_id"], update.message.video.file_id, caption=update.message.caption or "")
            elif btype == "doc" and update.message.document:
                await context.bot.send_document(u["user_id"], update.message.document.file_id, caption=update.message.caption or "")
            sent += 1
        except:
            failed += 1

    await update.message.reply_text(f"📣 Broadcast complete.\n✅ Sent: {sent}\n❌ Failed: {failed}")
    return ConversationHandler.END

