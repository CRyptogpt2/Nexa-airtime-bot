        uname = text.lstrip("@")
        user = conn.execute("SELECT * FROM users WHERE username=?", (uname,)).fetchone()
    conn.close()

    if action == "ban":
        if user:
            conn = get_db()
            conn.execute("UPDATE users SET is_banned=1 WHERE user_id=?", (user["user_id"],))
            conn.commit()
            conn.close()
            await update.message.reply_text(f"🚫 User {user['user_id']} banned.")
        else:
            await update.message.reply_text("User not found.")
