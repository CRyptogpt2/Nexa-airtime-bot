async def task_action(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    user_id = update.effective_user.id

    data = query.data
    if data.startswith("task_open_"):
        task_id = int(data.split("_")[2])
        context.user_data[f"opened_task_{task_id}"] = True
        await query.answer("Link opened! Come back and click Done.", show_alert=True)
        return

    if data.startswith("task_done_"):
        task_id = int(data.split("_")[2])
        conn = get_db()
        already = conn.execute(
            "SELECT 1 FROM completed_tasks WHERE user_id=? AND task_id=?", (user_id, task_id)
        ).fetchone()
        conn.close()

        if already:
            await query.answer("✅ You already completed this task.", show_alert=True)
            return

        if not context.user_data.get(f"opened_task_{task_id}"):
            await query.answer("⚠️ Please open the task link first.", show_alert=True)
            return

        conn = get_db()
        task = conn.execute("SELECT * FROM tasks WHERE task_id=?", (task_id,)).fetchone()
        conn.execute("""
            INSERT INTO completed_tasks (user_id, task_id, completed_at)
            VALUES (?, ?, ?)
        """, (user_id, task_id, datetime.now().isoformat()))
        conn.commit()
        conn.close()

        update_user_points(user_id, task["reward"], f"Completed task: {task['title']}")
        await query.edit_message_text(
            f"✅ Task completed! You earned *{task['reward']} points*.",
            parse_mode="Markdown",
            reply_markup=back_home()
        )
        return

    # View task
    task_id = int(data.split("_")[1])
    conn = get_db()
    task = conn.execute("SELECT * FROM tasks WHERE task_id=?", (task_id,)).fetchone()
    already = conn.execute(
        "SELECT 1 FROM completed_tasks WHERE user_id=? AND task_id=?", (user_id, task_id)
    ).fetchone()
    conn.close()

    if not task:
        await query.edit_message_text("Task not found.", reply_markup=back_home())
        return

    if already:
        await query.edit_message_text(
            f"✅ You already completed *{task['title']}*.",
            parse_mode="Markdown",
            reply_markup=back_home()
        )
        return

    text = (
        f"📌 *{task['title']}*\n\n"
        f"{task['description']}\n\n"
        f"🏆 Reward: *{task['reward']} points*\n"
        f"📂 Type: {task['task_type']}"
    )
    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton("🔗 Open Link", url=task["link"])],
        [InlineKeyboardButton("✅ Done", callback_data=f"task_done_{task_id}")],
        [InlineKeyboardButton("◀️ Back", callback_data="tasks")]
    ])
    context.user_data[f"opened_task_{task_id}"] = False
    await query.edit_message_text(text, parse_mode="Markdown", reply_markup=keyboard)

