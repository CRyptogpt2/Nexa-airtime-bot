async def earn(update: Update, context: ContextTypes.DEFAULT_TYPE):
    q = update.callback_query
    await q.answer()
    uid = q.from_user.id
    user = get_user(uid)
    kb = []

    if not user["channel_joined"]:
        kb.append([InlineKeyboardButton("📢 Join Telegram Channel (+20)", callback_data="task_channel")])
    if not user["twitter_followed"]:
        kb.append([InlineKeyboardButton("🐦 Follow on Twitter (+10)", callback_data="task_follow")])
    if not user["twitter_liked"]:
        kb.append([InlineKeyboardButton("❤️ Like Tweet (+10)", callback_data="task_like")])
    if not user["twitter_retweeted"]:
        kb.append([InlineKeyboardButton("🔁 Retweet (+15)", callback_data="task_retweet")])

    custom_tasks = get_active_tasks()
    for task in custom_tasks:
        if not has_completed_task(uid, task["id"]):
            emoji = task_type_emoji(task["task_type"])
            kb.append([InlineKeyboardButton(
                f"{emoji} {task['name']} (+{task['points']})",
                callback_data=f"custom_task_{task['id']}"
            )])

    if not kb:
        kb.append([InlineKeyboardButton("✅ All tasks completed!", callback_data="earn")])

    kb.append([InlineKeyboardButton("🔙 Back", callback_data="main_menu")])
    await safe_edit(q,
        "🎁 *Earn Points*\n\nComplete tasks below to earn points:",
        parse_mode="Markdown",
        reply_markup=InlineKeyboardMarkup(kb)
    )

