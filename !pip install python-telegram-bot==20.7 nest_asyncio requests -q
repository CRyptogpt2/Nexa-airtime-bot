async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    args = context.args

    db_user = get_or_create_user(user.id, user.username or "", user.first_name or "")

    # Handle referral code
    if args and not db_user["referred_by"]:
        ref_code = args[0]
        conn = get_db()
        referrer = conn.execute("SELECT * FROM users WHERE referral_code=?", (ref_code,)).fetchone()
        conn.close()
        if referrer and referrer["user_id"] != user.id:
            conn = get_db()
            conn.execute("UPDATE users SET referred_by=? WHERE user_id=?", (referrer["user_id"], user.id))
            conn.execute("""
                INSERT OR IGNORE INTO referrals (referrer_id, referred_id, created_at)
                VALUES (?, ?, ?)
            """, (referrer["user_id"], user.id, datetime.now().isoformat()))
            conn.commit()
            conn.close()

    db_user = get_user(user.id)

    if db_user["is_banned"]:
        await update.message.reply_text("❌ You have been banned from this bot.")
        return

    if db_user["onboarding_complete"]:
        await update.message.reply_text(
            f"👋 Welcome back, {user.first_name}!\n\nUse the menu below.",
            reply_markup=home_keyboard()
        )
        return

    welcome_msg = get_setting("welcome_message")
    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton("📢 Join Channel", url=CHANNEL_LINK)],
        [InlineKeyboardButton("✅ Verify Channel", callback_data="verify_channel")]
    ])
    await update.message.reply_text(welcome_msg, reply_markup=keyboard)

async def verify_channel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    user = update.effective_user
    db_user = get_user(user.id)

    if db_user["channel_joined"]:
        await show_x_follow(query)
        return

    try:
        member = await context.bot.get_chat_member(CHANNEL_USERNAME, user.id)
        if member.status in ["member", "administrator", "creator"]:
            reward = int(get_setting("channel_reward"))
            conn = get_db()
            conn.execute("UPDATE users SET channel_joined=1 WHERE user_id=?", (user.id,))
            conn.commit()
            conn.close()
            update_user_points(user.id, reward, "Joined Telegram channel")
            await query.edit_message_text(
                f"✅ Channel verified! You earned *{reward} points*.\n\nNext: Follow us on X.",
                parse_mode="Markdown",
                reply_markup=InlineKeyboardMarkup([
                    [InlineKeyboardButton("🐦 Follow on X", url=X_LINK, callback_data="x_follow_opened")],
                    [InlineKeyboardButton("✅ Done", callback_data="x_follow_done")]
                ])
            )
            context.user_data["x_link_opened"] = False
        else:
            await query.answer("❌ You haven't joined the channel yet!", show_alert=True)
    except Exception as e:
        await query.answer("❌ Verification failed. Please join and try again.", show_alert=True)

