async def send_airtime(phone, network, amount_naira):
    service_id = NETWORK_SERVICE_IDS.get(network, network.lower())
    payload = {
        "serviceID": service_id,
        "phone": phone,
        "amount": str(int(amount_naira)),
    }
    headers = {
        "Authorization": GSUBZ_API_KEY,
        "Content-Type": "application/x-www-form-urlencoded"
    }
    try:
        async with httpx.AsyncClient(timeout=30) as client:
            resp = await client.post(GSUBZ_API_URL, data=payload, headers=headers)
            data = resp.json()
            if data.get("status") == "success" or data.get("code") == "000":
                return True, data
            else:
                return False, data
    except Exception as e:
        return False, {"error": str(e)}

