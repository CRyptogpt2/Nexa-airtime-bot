async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    args = context.args
    referrer_id = None

    if args and args[0].startswith("ref_"):
        try:
            referrer_id = int(args[0].replace("ref_", ""))
            if referrer_id == user.id:
                referrer_id = None
        except ValueError:
            pass

    existing = get_user(user.id)
    create_user(user.id, user.username, referrer_id)

    if not existing and referrer_id:
        ref_user = get_user(referrer_id)
        if ref_user:
            conn = get_conn()
            try:
                conn.execute(
                    "INSERT OR IGNORE INTO referrals (referrer_id, referred_id) VALUES (?,?)",
                    (referrer_id, user.id)
                )
                conn.commit()
            except Exception:
                pass
            conn.close()
            update_points(referrer_id, POINTS_REFERRAL)
            try:
                await context.bot.send_message(
                    referrer_id,
                    f"🎉 You earned *+{POINTS_REFERRAL} points!* Someone joined via your referral link.",
                    parse_mode="Markdown"
                )
            except Exception:
                pass

    await update.message.reply_text(
        f"👋 Welcome to *Nexarion Bot*, {user.first_name}!\n\n"
        f"Earn points by completing tasks and redeem them for FREE airtime! 📱\n\n"
        f"📌 *1000 points = ₦300 airtime*\n"
        f"📌 *1667 points = ₦500 airtime*\n"
        f"📌 *3334 points = ₦1000 airtime*\n\n"
        f"Use the menu below to get started:",
        parse_mode="Markdown",
        reply_markup=main_menu_keyboard()
    )

