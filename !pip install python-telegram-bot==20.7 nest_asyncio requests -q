def get_conn():
    conn = sqlite3.connect(DATABASE_PATH, check_same_thread=False)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    conn = get_conn()
    c = conn.cursor()
    c.execute("""
    CREATE TABLE IF NOT EXISTS users (
        user_id INTEGER PRIMARY KEY,
        username TEXT,
        points INTEGER DEFAULT 0,
        join_date TEXT DEFAULT (datetime('now')),
        referrer_id INTEGER DEFAULT NULL,
        channel_joined INTEGER DEFAULT 0,
        twitter_followed INTEGER DEFAULT 0,
        twitter_liked INTEGER DEFAULT 0,
        twitter_retweeted INTEGER DEFAULT 0
    )
    """)
    c.execute("""
    CREATE TABLE IF NOT EXISTS withdrawals (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        network TEXT,
        phone TEXT,
        amount TEXT,
        status TEXT,
        time TEXT DEFAULT (datetime('now'))
    )
    """)
    c.execute("""
    CREATE TABLE IF NOT EXISTS referrals (
        referrer_id INTEGER,
        referred_id INTEGER,
        UNIQUE(referred_id)
    )
    """)
    c.execute("""
    CREATE TABLE IF NOT EXISTS custom_tasks (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT,
        link TEXT,
        points INTEGER,
        task_type TEXT,
        active INTEGER DEFAULT 1
    )
    """)
    c.execute("""
    CREATE TABLE IF NOT EXISTS completed_tasks (
        user_id INTEGER,
        task_id INTEGER,
        UNIQUE(user_id, task_id)
    )
    """)
    conn.commit()
    conn.close()

def get_user(uid):
    conn = get_conn()
    u = conn.execute("SELECT * FROM users WHERE user_id=?", (uid,)).fetchone()
    conn.close()
    return u

def get_user_by_username(username):
    username = username.lstrip("@").lower()
    conn = get_conn()
    u = conn.execute("SELECT * FROM users WHERE LOWER(username)=?", (username,)).fetchone()
    conn.close()
    return u

def create_user(uid, username, referrer_id=None):
    conn = get_conn()
    conn.execute(
        "INSERT OR IGNORE INTO users (user_id, username, referrer_id) VALUES (?,?,?)",
        (uid, username, referrer_id)
    )
    conn.commit()
    conn.close()

def update_points(uid, amt):
    conn = get_conn()
    conn.execute("UPDATE users SET points = points + ? WHERE user_id=?", (amt, uid))
    conn.commit()
    conn.close()

def get_points(uid):
    conn = get_conn()
    r = conn.execute("SELECT points FROM users WHERE user_id=?", (uid,)).fetchone()
    conn.close()
    return r["points"] if r else 0

def get_all_users():
    conn = get_conn()
    rows = conn.execute("SELECT * FROM users ORDER BY points DESC").fetchall()
    conn.close()
    return rows

def get_withdrawals():
    conn = get_conn()
    rows = conn.execute("SELECT * FROM withdrawals ORDER BY time DESC LIMIT 50").fetchall()
    conn.close()
    return rows

def set_flag(uid, field):
    conn = get_conn()
    conn.execute(f"UPDATE users SET {field}=1 WHERE user_id=?", (uid,))
    conn.commit()
    conn.close()

def get_referral_count(uid):
    conn = get_conn()
    r = conn.execute("SELECT COUNT(*) as cnt FROM referrals WHERE referrer_id=?", (uid,)).fetchone()
    conn.close()
    return r["cnt"] if r else 0

def get_active_tasks():
    conn = get_conn()
    rows = conn.execute("SELECT * FROM custom_tasks WHERE active=1").fetchall()
    conn.close()
    return rows

def get_task(task_id):
    conn = get_conn()
    t = conn.execute("SELECT * FROM custom_tasks WHERE id=?", (task_id,)).fetchone()
    conn.close()
    return t

def has_completed_task(uid, task_id):
    conn = get_conn()
    r = conn.execute("SELECT 1 FROM completed_tasks WHERE user_id=? AND task_id=?", (uid, task_id)).fetchone()
    conn.close()
    return r is not None

def mark_task_complete(uid, task_id):
    conn = get_conn()
    try:
        conn.execute("INSERT OR IGNORE INTO completed_tasks (user_id, task_id) VALUES (?,?)", (uid, task_id))
        conn.commit()
    except Exception:
        pass
    conn.close()

def add_custom_task(name, link, points, task_type):
    conn = get_conn()
    conn.execute(
        "INSERT INTO custom_tasks (name, link, points, task_type) VALUES (?,?,?,?)",
        (name, link, points, task_type)
    )
    conn.commit()
    conn.close()

def delete_custom_task(task_id):
    conn = get_conn()
    conn.execute("UPDATE custom_tasks SET active=0 WHERE id=?", (task_id,))
    conn.commit()
    conn.close()

