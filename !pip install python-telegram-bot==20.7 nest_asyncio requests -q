    network = query.data.replace("net_", "")
    context.user_data["withdraw_network"] = network

    user = get_user(update.effective_user.id)
    pts_per = int(get_setting("points_per_conversion"))
    naira_per = float(get_setting("naira_per_conversion"))
    points = user["points"]
    max_pts = (points // pts_per) * pts_per
    naira = (max_pts / pts_per) * naira_per

    daily_limit = float(get_setting("daily_limit_naira"))
    daily_used = get_daily_withdrawn(update.effective_user.id)
    remaining = daily_limit - daily_used
    if naira > remaining:
        naira = remaining
        max_pts = int((naira / naira_per) * pts_per)

    context.user_data["withdraw_points"] = max_pts
    context.user_data["withdraw_naira"] = naira

    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton("✅ Confirm", callback_data="confirm_withdraw"),
         InlineKeyboardButton("❌ Cancel", callback_data="cancel_withdraw")]
    ])
    await query.edit_message_text(
        f"💸 *Withdrawal Summary*\n\n"
        f"📱 Phone: `{context.user_data['withdraw_phone']}`\n"
        f"📡 Network: *{network}*\n"
        f"💰 Points: *{max_pts}*\n"
        f"💵 Airtime: *₦{naira:.0f}*\n\n"
        f"Confirm?",
        parse_mode="Markdown",
        reply_markup=keyboard
    )
    return WITHDRAW_CONFIRM

async def withdraw_confirm(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    if query.data == "cancel_withdraw":
        await query.edit_message_text("❌ Withdrawal cancelled.", reply_markup=back_home())
        return ConversationHandler.END

    user_id = update.effective_user.id
    phone = context.user_data["withdraw_phone"]
    network = context.user_data["withdraw_network"]
    points = context.user_data["withdraw_points"]
    naira = context.user_data["withdraw_naira"]

    await query.edit_message_text("⏳ Processing your airtime request...")

    success, response = await send_airtime(phone, network, naira)

    if success:
        conn = get_db()
        conn.execute("""
            INSERT INTO withdrawals (user_id, phone, network, points, naira_amount, status, created_at, processed_at)
            VALUES (?, ?, ?, ?, ?, 'completed', ?, ?)
        """, (user_id, phone, network, points, naira, datetime.now().isoformat(), datetime.now().isoformat()))
        conn.execute("UPDATE users SET points = points - ?, total_withdrawn = total_withdrawn + ? WHERE user_id=?",
                     (points, points, user_id))
        conn.commit()
        conn.close()
        update_user_points(user_id, -points, f"Airtime withdrawal ₦{naira:.0f}", txn_type="withdraw")

        await query.edit_message_text(
            f"✅ *Success!*\n\n₦{naira:.0f} airtime sent to *{phone}* ({network}).\n\n*{points} points* deducted.",
            parse_mode="Markdown",
            reply_markup=back_home()
        )

        # Notify admin
        for admin_id in ADMIN_IDS:
            try:
                await context.bot.send_message(
                    admin_id,
                    f"💸 Airtime Sent\nUser: {user_id}\nPhone: {phone}\nNetwork: {network}\nAmount: ₦{naira:.0f}\nStatus: ✅ Success"
                )
            except:
                pass
    else:
        conn = get_db()
        conn.execute("""
            INSERT INTO withdrawals (user_id, phone, network, points, naira_amount, status, created_at)
            VALUES (?, ?, ?, ?, ?, 'failed', ?)
        """, (user_id, phone, network, points, naira, datetime.now().isoformat()))
        conn.commit()
        conn.close()

        await query.edit_message_text(
            f"❌ Airtime delivery failed.\n\nError: {response.get('message', 'Unknown error')}\n\nYour points were NOT deducted. Please try again.",
            reply_markup=back_home()
        )

    return ConversationHandler.END

