async def is_member(bot, uid):
    try:
        member = await bot.get_chat_member(TELEGRAM_CHANNEL_ID, uid)
        return member.status in ["member", "administrator", "creator"]
    except Exception:
        return False

def send_airtime_via_vtu(network, phone, amount):
    try:
        payload = {
            "api_key": VTU_API_KEY,
            "network": network.lower(),
            "phone": phone,
            "amount": amount,
            "type": "airtime",
        }
        response = requests.post(VTU_API_URL, json=payload, timeout=30)
        data = response.json()
        return data.get("status") == "success", data.get("message", "Unknown error")
    except Exception as e:
        return False, str(e)

